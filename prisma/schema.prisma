// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
   provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model News {
  id        Int      @id @default(autoincrement())
  date      DateTime @default(now())
  news      String
  isMain    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model CompanyInfo {
  id           Int            @id @default(autoincrement())
  name         String
  email        String?
  address      String?
  workingHours String?
  directorName String?
  deputyName   String?
  phones       CompanyPhone[]
  insurances CompanyInsurance?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model CompanyPhone {
  id            Int         @id @default(autoincrement())
  phone         String
  label         String?
  signature     String?
  createdAt     DateTime    @default(now())
  companyInfo   CompanyInfo @relation(fields: [companyInfoId], references: [id])
  companyInfoId Int
}

model CompanyInsurance {
  id            Int         @id @default(autoincrement())
  insurer     String
  number        String
  dateBegin    DateTime
  dateEnd      DateTime

  companyId   Int      @unique
  company     CompanyInfo @relation(fields: [companyId], references: [id], onDelete: Cascade)

  updatedAt   DateTime @updatedAt
}

enum RouteType {
  SUBURBAN
  CITY
}

enum SeasonType {
  SUMMER
  AUTUMN
  WINTER
  SPRING
}

enum DepartureDirection {
  FROM_START
  FROM_END
}

enum DayOfWeek {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

model Season {
  id Int @id @default(autoincrement())
  type SeasonType @unique
  periods SeasonPeriod[]
  routes Route[]
}

model SeasonPeriod {
  id Int @id @default(autoincrement())
  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  seasonId Int
  startMonth Int
  startDay   Int
  endMonth   Int
  endDay     Int
}

model Route {
  id Int @id @default(autoincrement())
  number String
  name String
  type RouteType
  isCircular Boolean          @default(false)
  season Season @relation(fields: [seasonId], references: [id])
  seasonId Int
  departures RouteDeparture[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([seasonId, type, number])
}

model RouteDeparture {
  id Int @id @default(autoincrement())
  route Route @relation(fields: [routeId], references: [id], onDelete: Cascade)
  routeId Int
  direction DepartureDirection
  time String
  dayOfWeek DayOfWeek[]
  comment String?
}